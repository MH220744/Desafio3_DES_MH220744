@model List<BolsaTrabajo.MVC.Models.PlazaViewModel>

@{
    ViewData["Title"] = "Mis plazas";
}

<h2>Mis plazas</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<a asp-action="Crear"
   class="btn btn-success mb-3">
    Nueva plaza
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>Institución</th>
            <th>Cierre</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var plaza in Model)
        {
            <tr>
                <td>@plaza.Titulo</td>

                <td>
                    @plaza.Institucion
                </td>

                <td>
                    @plaza.FechaCierre.ToString("dd/MM/yyyy")
                </td>

                <td>
                    @switch (plaza.Estado)
                    {
                        case 1:
                            <span class="badge bg-success">
                                Abierta
                            </span>
                            break;

                        case 2:
                            <span class="badge bg-warning text-dark">
                                En evaluación
                            </span>
                            break;

                        case 3:
                            <span class="badge bg-secondary">
                                Cerrada
                            </span>
                            break;
                    }
                </td>

                <td>
                    <a asp-action="Editar"
                       asp-route-id="@plaza.IdPlaza"
                       class="btn btn-primary btn-sm">
                        Editar
                    </a>

                    <a asp-action="Postulaciones"
                       asp-route-id="@plaza.IdPlaza"
                       class="btn btn-info btn-sm">
                        Postulaciones
                    </a>

                    <form asp-action="Eliminar"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('¿Está seguro de eliminar esta plaza?');">

                        <input type="hidden"
                               name="id"
                               value="@plaza.IdPlaza" />

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Eliminar
                        </button>

                    </form>

                    <form asp-action="CambiarEstado"
                          method="post"
                          class="d-inline">

                        <input type="hidden"
                               name="id"
                               value="@plaza.IdPlaza" />

                        <input type="hidden"
                               name="estado"
                               value="2" />

                        <button class="btn btn-warning btn-sm">
                            En evaluación
                        </button>
                    </form>

                    <form asp-action="CambiarEstado"
                          method="post"
                          class="d-inline">

                        <input type="hidden"
                               name="id"
                               value="@plaza.IdPlaza" />

                        <input type="hidden"
                               name="estado"
                               value="3" />

                        <button class="btn btn-danger btn-sm">
                            Cerrar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>