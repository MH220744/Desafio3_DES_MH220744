@model List<BolsaTrabajo.MVC.Models.PostulacionViewModel>

@{
    ViewData["Title"] = "Postulaciones";
}

<h2>Postulaciones de la plaza</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Esta plaza todavía no tiene postulaciones.
    </div>
}
else
{
    <table class="table table-striped align-middle">

        <thead>
            <tr>
                <th>ID</th>
                <th>Candidato</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.IdPostulacion
                    </td>

                    <td>
                        @item.IdCandidato
                    </td>

                    <td>
                        @(item.FechaPostulacion.ToString("dd/MM/yyyy HH:mm"))
                    </td>

                    <td>

                        @switch (item.Estado)
                        {
                            case 1:
                                <span class="badge bg-warning text-dark">
                                    En revisión
                                </span>
                                break;

                            case 2:
                                <span class="badge bg-success">
                                    Aprobado
                                </span>
                                break;

                            case 3:
                                <span class="badge bg-danger">
                                    Rechazado
                                </span>
                                break;

                            default:
                                <span class="badge bg-secondary">
                                    Desconocido
                                </span>
                                break;
                        }

                    </td>

                    <td>

                        @if (item.Estado != 2)
                        {
                            <form asp-action="CambiarEstadoPostulacion"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="idPostulacion"
                                       value="@item.IdPostulacion" />

                                <input type="hidden"
                                       name="idPlaza"
                                       value="@ViewBag.IdPlaza" />

                                <input type="hidden"
                                       name="estado"
                                       value="2" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Aprobar
                                </button>

                            </form>
                        }

                        @if (item.Estado != 3)
                        {
                            <form asp-action="CambiarEstadoPostulacion"
                                  method="post"
                                  class="d-inline">

                                <input type="hidden"
                                       name="idPostulacion"
                                       value="@item.IdPostulacion" />

                                <input type="hidden"
                                       name="idPlaza"
                                       value="@ViewBag.IdPlaza" />

                                <input type="hidden"
                                       name="estado"
                                       value="3" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Rechazar
                                </button>

                            </form>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Volver
</a>