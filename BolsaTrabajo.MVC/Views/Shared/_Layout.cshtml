<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bolsa de Trabajo</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BolsaTrabajo.MVC.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Bolsa de Trabajo
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (Context.Session.GetString("ApiCookie") != null)
                        {
                            var rol =
                                Context.Session.GetString("RolUsuario");

                            if (rol == "Candidato")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Candidato"
                                       asp-action="Index">
                                        Plazas
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Candidato"
                                       asp-action="MisPostulaciones">
                                        Mis postulaciones
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Candidato"
                                       asp-action="HojaDeVida">
                                        Hoja de vida
                                    </a>
                                </li>

                                <li class="nav-item">
    <a class="nav-link text-dark"
       asp-controller="Candidato"
       asp-action="Perfil">
        Mi perfil
    </a>
</li>
                            }

                            if (rol == "Agente")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Agente"
                                       asp-action="Index">
                                        Mis plazas
                                    </a>
                                </li>
                            }

                            if (rol == "Administrador")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Administrador"
                                       asp-action="Index">
                                        Administración
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto">

                        @if (Context.Session.GetString("ApiCookie") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    @Context.Session.GetString("NombreUsuario")
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Cuenta"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="btn btn-outline-danger">
                                        Cerrar sesión
                                    </button>

                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Cuenta"
                                   asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Cuenta"
                                   asp-action="Registro">
                                    Registrarse
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <div class="container">

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensaje"]
            </div>
        }

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>

    <footer class="border-top footer text-muted">

        <div class="container">
            &copy; 2026 - Bolsa de Trabajo del Sector Público
        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>